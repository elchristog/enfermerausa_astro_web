---
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'home' | 'service' | 'faq' | 'article' | 'info';
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
  ogImage?: string;
  authorName?: string;
  authorRole?: string;
}

const { title, description, canonical, type, faqs, datePublished, ogImage, authorName, authorRole } = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} type={type} faqs={faqs} datePublished={datePublished} ogImage={ogImage} authorName={authorName} authorRole={authorRole} />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <link rel="dns-prefetch" href="https://px.get-ryze.ai" />
    <noscript>
      <img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=309464551754526&ev=PageView&noscript=1" />
    </noscript>
    <script is:inline>
      // Load analytics after the page is interactive so they don't delay first paint.
      window.addEventListener('load', function () {
        var idle = window.requestIdleCallback || function (cb) { setTimeout(cb, 1); };
        idle(function () {
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZF1G0T80D2';
          document.head.appendChild(g);
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', 'G-ZF1G0T80D2');
          gtag('config', 'AW-988351308');

          !function(f,b,e,v,n,t,s){
            if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)
          }(window, document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', '309464551754526');
          fbq('track', 'PageView');

          var r = document.createElement('script');
          r.async = true;
          r.src = 'https://px.get-ryze.ai/px.js';
          r.setAttribute('data-key', 'rz_pk_ef648ae0587e39e5432c2763244613a3');
          document.head.appendChild(r);
        });
      });
    </script>
    <script is:inline>
      // Guarda de dónde llegó la visita (anuncio, buscador, referido) para pasarlo a la reserva.
      (function () {
        try {
          var p = new URLSearchParams(location.search);
          var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
          var d = {}, has = false;
          keys.forEach(function (k) { var v = p.get(k); if (v) { d[k] = v.slice(0, 100); has = true; } });
          if (!d.utm_source && p.get('gclid')) { d.utm_source = 'google'; d.utm_medium = d.utm_medium || 'cpc'; has = true; }
          if (!d.utm_source && p.get('fbclid')) { d.utm_source = 'facebook'; d.utm_medium = d.utm_medium || 'paid'; has = true; }
          var prev = localStorage.getItem('eeeu_attr');
          if (has) {
            d.t = Date.now();
            localStorage.setItem('eeeu_attr', JSON.stringify(d));
          } else if (!prev) {
            var ref = document.referrer ? new URL(document.referrer).hostname.replace(/^www\./, '') : '';
            if (ref && ref.indexOf('enfermerausa.com') === -1) {
              var src = ref, med = 'referral';
              if (/(^|\.)(gemini\.google\.com|chatgpt\.com|chat\.openai\.com|perplexity\.ai|copilot\.microsoft\.com|claude\.ai)$/.test(ref)) { src = ref.split('.').slice(-2, -1)[0] === 'google' ? 'gemini' : ref.split('.').slice(-2, -1)[0]; med = 'ai'; }
              else if (/(^|\.)google\.[a-z.]+$/.test(ref)) { src = 'google'; med = 'organic'; }
              else if (/(^|\.)bing\.com$/.test(ref)) { src = 'bing'; med = 'organic'; }
              else if (/(^|\.)(duckduckgo\.com|search\.yahoo\.com|ecosia\.org|yandex\.com)$/.test(ref)) { src = ref.replace(/^search\./, '').split('.')[0]; med = 'organic'; }
              localStorage.setItem('eeeu_attr', JSON.stringify({ utm_source: src, utm_medium: med, t: Date.now() }));
            }
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex flex-col bg-white min-h-dvh">
    <Navigation />
    <main class="flex-grow pt-24"><slot /></main>
    <Footer />
  </body>
</html>
