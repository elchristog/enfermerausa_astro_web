---
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/global/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'home' | 'service' | 'faq' | 'article';
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, canonical, type, faqs } = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} type={type} faqs={faqs} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZF1G0T80D2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-ZF1G0T80D2');
    </script>
    <script async src="https://px.get-ryze.ai/px.js" data-key="rz_pk_ef648ae0587e39e5432c2763244613a3"></script>
  </head>
  <body class="flex flex-col bg-white min-h-dvh">
    <Navigation />
    <main class="flex-grow pt-24"><slot /></main>
    <Footer />
  </body>
</html>
