---
// Calificación visible de Trustpilot + widget oficial (TrustBox «Review Collector»).
// Los valores vienen de src/data/trustpilot.mjs (un solo lugar).
// El script de arranque de TrustBox se carga una sola vez en BaseLayout.astro.
// Decisión del dueño: NO mostrar cuántas reseñas hay; solo la puntuación.
import { trustpilot, ratingEs } from "@/data/trustpilot.mjs";

interface Props {
  dark?: boolean;
  class?: string;
}
const { dark = false, class: extra = "" } = Astro.props;
const hasBox = Boolean(trustpilot.businessUnitId);
const wrap = dark
  ? "border-slate-700 bg-slate-900/70 text-slate-200"
  : "border-slate-200 bg-white text-slate-700";
const link = dark ? "text-emerald-400" : "text-emerald-700";
---

<div class={`mx-auto flex max-w-xl flex-col items-center gap-2 rounded-xl border px-4 py-3 text-center ${wrap} ${extra}`} data-trustpilot-rating>
  <p class="text-sm">
    <strong>Calificación en Trustpilot: {ratingEs}/5</strong> ·
    <a href={trustpilot.profileUrl} target="_blank" rel="noopener noreferrer" class={`font-semibold underline ${link}`}>Ver las reseñas en Trustpilot</a>
  </p>
  {hasBox && (
    <div
      class="trustpilot-widget w-full"
      data-locale={trustpilot.locale}
      data-template-id={trustpilot.templateId}
      data-businessunit-id={trustpilot.businessUnitId}
      data-style-height="52px"
      data-style-width="100%"
    >
      <a href={trustpilot.profileUrl} target="_blank" rel="noopener noreferrer">Trustpilot</a>
    </div>
  )}
</div>
