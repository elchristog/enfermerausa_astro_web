---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
  alternates?: Array<{ href: string; lang: string }>;
}

const {
  title = "Agencia para Enfermeras en USA | Homologación, Visa y Empleo",
  description = "La principal y más grande agencia para enfermeros hispanos en Estados Unidos. Únete a miles de casos de éxito. Homologación, sponsor y empleo.",
  canonical = "https://enfermerausa.com",
  ogImage = "https://enfermerausa.com/logo.webp",
  type = "website",
  alternates = []
} = Astro.props;

// hreflang: solo se pasa cuando hay alternates definidos (par en/es)
const alternateLanguages = alternates.length > 0
  ? Object.fromEntries(alternates.map(a => [a.lang, a.href]))
  : null;
const seoExtraProps = alternateLanguages ? { alternates: { languages: alternateLanguages } } : {};
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title: title,
    description: description,
    images: [
      {
        url: ogImage,
        width: 1200,
        height: 630,
        alt: title,
        type: "image/webp",
      },
    ],
    site_name: "Enfermera en Estados Unidos",
    type,
    locale: "es_US",
  }}
  twitter={{
    handle: "@enfermerausa",
    site: "@enfermerausa",
    cardType: "summary_large_image",
  }}
  {...seoExtraProps}
/>
