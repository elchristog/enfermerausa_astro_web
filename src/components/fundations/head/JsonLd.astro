---
interface Props {
  type?: 'home' | 'service' | 'faq' | 'article' | 'info';
  title?: string;
  description?: string;
  url?: string;
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
  authorName?: string;
  authorRole?: string;
  image?: string;
}

const {
  type = 'home',
  title = 'Enfermera en Estados Unidos - Agencia de Reclutamiento para Enfermeros Hispanos',
  description = 'Agencia líder en homologación de título de enfermería, preparación NCLEX, visa EB-3 y patrocinio en EE.UU.',
  url = 'https://enfermerausa.com',
  faqs = [],
  datePublished = '2026-01-01',
  authorName,
  authorRole,
  image
} = Astro.props;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://enfermerausa.com/#organization",
  "name": "Enfermera en Estados Unidos",
  "url": "https://enfermerausa.com",
  "logo": "https://enfermerausa.com/logo.webp",
  "email": "hello@enfermeraenestadosunidos.com",
  "sameAs": [
    "https://www.instagram.com/enfermeraenestadosunidos",
    "https://www.facebook.com/enfermeraenestadosunidosusa",
    "https://www.youtube.com/@enfermeraenestadosunidos",
    "https://www.tiktok.com/@enfermeraenestadosunidos"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://enfermerausa.com/#website",
  "name": "Enfermera en Estados Unidos",
  "url": "https://enfermerausa.com",
  "inLanguage": "es",
  "publisher": { "@id": "https://enfermerausa.com/#organization" }
};

const programSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  "name": "Programa de Homologación y Empleo para Enfermeras en EE.UU.",
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "Enfermera en Estados Unidos",
    "url": "https://enfermerausa.com",
    "logo": "https://enfermerausa.com/logo.webp",
    "email": "hello@enfermeraenestadosunidos.com",
    "sameAs": [
      "https://www.instagram.com/enfermeraenestadosunidos",
      "https://www.facebook.com/enfermeraenestadosunidosusa",
      "https://www.youtube.com/@enfermeraenestadosunidos",
      "https://www.tiktok.com/@enfermeraenestadosunidos"
    ]
  },
  "occupationalCategory": "Registered Nurse (RN)",
  "educationalProgramMode": "online",
  "offers": {
    "@type": "Offer",
    "category": "Asesoría de Homologación y Visados"
  }
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": url,
  "inLanguage": "es",
  "isPartOf": { "@id": "https://enfermerausa.com/#website" },
  "publisher": { "@id": "https://enfermerausa.com/#organization" }
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "mainEntityOfPage": url,
  "datePublished": datePublished,
  "dateModified": datePublished,
  "inLanguage": "es",
  ...(image ? { "image": [image] } : {}),
  "author": {
    "@type": "Person",
    "name": authorName || "Alejandra Martínez",
    "jobTitle": authorRole || "RN, BSN, IBCLC",
    "worksFor": { "@type": "Organization", "name": "Enfermera en Estados Unidos", "url": "https://enfermerausa.com" }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Enfermera en Estados Unidos",
    "logo": {
      "@type": "ImageObject",
      "url": "https://enfermerausa.com/logo.webp"
    }
  }
} : null;
---

{type === 'home' && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
{type === 'home' && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
{(type === 'service' || type === 'faq') && <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />}
{type === 'info' && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebPage", "name": title, "description": description, "url": url, "inLanguage": "es", "isPartOf": { "@id": "https://enfermerausa.com/#website" }, "publisher": { "@id": "https://enfermerausa.com/#organization" } })} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
