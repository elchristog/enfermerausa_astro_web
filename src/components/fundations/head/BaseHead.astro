---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";
import JsonLd from "@/components/fundations/head/JsonLd.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'home' | 'service' | 'faq' | 'article' | 'info';
  faqs?: Array<{ question: string; answer: string }>;
  datePublished?: string;
  ogImage?: string;
  authorName?: string;
  authorRole?: string;
}

const { title, description, canonical, type = 'home', faqs = [], datePublished, ogImage, authorName, authorRole } = Astro.props;
---
<Seo title={title} description={description} canonical={canonical} ogImage={ogImage} type={type === 'article' ? 'article' : 'website'} />
<Meta />
<Fonts />
<Favicons />
<JsonLd type={type} title={title} description={description} url={canonical} faqs={faqs} datePublished={datePublished} authorName={authorName} authorRole={authorRole} image={ogImage} />
