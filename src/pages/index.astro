---
import BaseLayout from "@/layouts/BaseLayout.astro";

const faqs = [
  {
    question: "¿Cuál es el sueldo de una enfermera en Estados Unidos?",
    answer: "Según el Bureau of Labor Statistics, la mediana nacional de una Registered Nurse (RN) es de $97,550 al año ($46.90/hora, mayo 2025). Por estado varía: Texas $90,210, Florida $84,760 y California $137,690 de media (OEWS mayo 2023). El neto depende de si el estado cobra impuesto a la renta."
  },
  {
    question: "¿Qué necesito para trabajar de enfermera en Estados Unidos?",
    answer: "En la práctica el camino es: 1) título y licencia de enfermería en tu país, 2) evaluación de credenciales que acepte la junta del estado (p. ej. vía CGFNS/TruMerit u otra autorizada), 3) aprobar el NCLEX-RN, 4) licencia de la junta estatal, 5) demostrar inglés cuando lo exija la junta o el empleador (IELTS, OET, PTE, etc.) y 6) una vía migratoria con sponsor —con frecuencia EB-3 Schedule A— más la oferta de un hospital."
  },
  {
    question: "¿Cuántos años se estudia para enfermera en Estados Unidos?",
    answer: "Si ya eres licenciada o titulado en tu país, no empiezas la carrera de cero: homologas, apruebas el NCLEX y obtienes la licencia estatal. Quien estudia enfermería dentro de EE.UU. suele hacer un ADN (~2 años) o un BSN (~4 años) y luego el NCLEX. Los tiempos de homologación + NCLEX + visa para internacionales se miden en meses o años según documentos, inglés y cola migratoria —no en un plazo único."
  },
  {
    question: "¿Cuáles son los tipos de enfermería en Estados Unidos?",
    answer: "Los niveles más citados son CNA (asistente), LPN/LVN (licencia práctica), RN (Registered Nurse, el objetivo habitual de homologación internacional) y roles avanzados (NP y otros con posgrado). Esta página y nuestro acompañamiento se centran en el camino a RN para hispanohablantes formados en el extranjero."
  },
  {
    question: "¿Puedo pagar el programa a plazos?",
    answer: "Sí. En el checkout puedes pagar el programa completo o fraccionarlo con Klarna o Affirm (según tu país y aprobación de la plataforma). Hay planes de hasta 36 cuotas, desde aproximadamente $83 al mes. En el pago elige «Pago completo o en cuotas», marca Klarna o Affirm y completa la solicitud."
  },
];

const testimonials = [
  {
    name: "Elizabeth Duque",
    detail: "Enfermera colombiana · Aprobó el NCLEX-RN",
    quote: "Pasé el NCLEX a la pregunta 85. Empecé con inglés básico y, con disciplina diaria y acompañamiento, di cada escalón del proceso. La noticia del pass es un logro que no se olvida.",
    videoId: "A13rKHMjH_c",
    videoUrl: "https://www.youtube.com/watch?v=A13rKHMjH_c",
    videoLabel: "Ver entrevista completa en YouTube",
  },
  {
    name: "Sara",
    detail: "Enfermera colombiana · NCLEX, PTE y oferta hospitalaria",
    quote: "Aprobé el NCLEX, el PTE de inglés y conseguí oferta con hospital. El proceso es largo, pero alcanzable: se vuelve un proyecto de vida. Lo difícil es empezar; después se sigue paso a paso.",
    videoId: "8kfnvoUVvvI",
    videoUrl: "https://www.youtube.com/watch?v=8kfnvoUVvvI",
    videoLabel: "Ver entrevista completa en YouTube",
  },
];
---

<BaseLayout
  title="Enfermera en Estados Unidos | Homologación, NCLEX y Empleo"
  description="Enfermera en Estados Unidos: homologación del título, NCLEX-RN, visa EB-3 y empleo con sponsor. Salarios BLS y sesión informativa en español."
  canonical="https://enfermerausa.com/"
  type="home"
  faqs={faqs}
>
  <section class="bg-gradient-to-b from-emerald-50/50 via-white to-white py-16 md:py-24 border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1.5 rounded-full mb-6 uppercase tracking-wider">
          Enfermera en Estados Unidos · Acompañamiento en español
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight mb-6">
          <span class="text-emerald-700">Enfermera en Estados Unidos</span>: de la homologación al empleo como RN
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          Acompañamos a enfermeras y enfermeros hispanohablantes en el camino completo: homologación del título, NCLEX-RN, licencia, visa EB-3 y empleo con sponsor. Empieza con la <strong>sesión informativa gratuita</strong>, en español y sin tecnicismos innecesarios.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://bit.ly/3R6RbFW"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-emerald-600/20 transition-all"
          >
            Agendar sesión informativa gratuita
          </a>
          <a
            href="/evaluacion-y-homologacion-de-titulo-enfermeria-usa/"
            class="w-full sm:w-auto inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold text-base px-6 py-4 rounded-xl transition-all"
          >
            Ver el proceso de homologación
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Quién te acompaña</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-4">
            Personas reales, proceso real, en español
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            <strong>Enfermera en Estados Unidos</strong> es el proyecto de acompañamiento que ya conoces en YouTube, Instagram y TikTok: explicación clara del camino a RN —homologación, NCLEX, inglés, empleo con sponsor y visa— sin promesas vacías.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            El canal <strong>Enfermera en Estados Unidos</strong> (más de 50.000 suscriptores) documenta entrevistas con enfermeras que ya dieron esos pasos. Aquí en la web concentramos las guías con fuentes oficiales y la puerta de entrada: la sesión informativa.
          </p>
          <ul class="text-sm text-gray-700 space-y-2">
            <li class="flex gap-2"><span class="text-emerald-600 font-bold">✓</span> Acompañamiento 100% en español</li>
            <li class="flex gap-2"><span class="text-emerald-600 font-bold">✓</span> Testimonios en video, verificables en YouTube</li>
            <li class="flex gap-2"><span class="text-emerald-600 font-bold">✓</span> Contenido alineado a NCSBN, BLS, CGFNS/TruMerit y juntas estatales</li>
          </ul>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 md:p-8">
          <p class="text-sm font-bold text-emerald-800 uppercase tracking-wide mb-3">El camino en 4 etapas</p>
          <ol class="space-y-3 text-sm text-gray-700">
            <li><strong>1. Homologación</strong> — credenciales y junta estatal. <a href="/evaluacion-y-homologacion-de-titulo-enfermeria-usa/" class="text-emerald-700 underline">Guía</a></li>
            <li><strong>2. NCLEX y licencia</strong> — examen y RN. <a href="/licencia-de-enfermeria-y-examen-nclex-usa/" class="text-emerald-700 underline">Guía</a></li>
            <li><strong>3. Empleo con sponsor</strong> — oferta hospitalaria. <a href="/ofertas-de-empleo-para-enfermeras-en-usa/" class="text-emerald-700 underline">Ofertas</a></li>
            <li><strong>4. Visa y llegada</strong> — EB-3 / green card. <a href="/proceso-de-visa-y-relocalizacion-para-enfermeras/" class="text-emerald-700 underline">Visa</a></li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-gray-50 border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-2xl mb-10">
        <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Casos reales</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-3">
          Ellas ya dieron el paso — en sus propias palabras
        </h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          No inventamos reseñas. Estas entrevistas están publicadas en el canal oficial de YouTube; puedes ver el video completo.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t) => (
          <figure class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col">
            <div class="relative w-full overflow-hidden rounded-xl bg-black mb-4" style="padding-bottom:56.25%">
              <iframe
                class="absolute inset-0 w-full h-full"
                src={`https://www.youtube-nocookie.com/embed/${t.videoId}`}
                title={`Entrevista: ${t.name}`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <blockquote class="text-gray-700 leading-relaxed text-sm md:text-base flex-1">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-5 pt-4 border-t border-gray-100">
              <p class="font-bold text-gray-900">{t.name}</p>
              <p class="text-xs text-gray-500 mb-3">{t.detail}</p>
              <a
                href={t.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-bold text-emerald-700 hover:text-emerald-800 underline"
              >
                {t.videoLabel} →
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-2xl mb-8">
        <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Salarios RN · Datos BLS</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-3">
          Cuánto gana una enfermera en Estados Unidos
        </h2>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
          Mediana nacional: <strong>$97,550 al año</strong> (BLS, mayo 2025). El bruto cambia por estado —y el neto, si hay impuesto estatal.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <a href="/salario-enfermera-texas/" class="block p-5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-emerald-300 hover:bg-emerald-50/40 transition">
          <span class="text-xs font-bold text-emerald-700 uppercase">Texas</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-1">$90,210</p>
          <p class="text-xs text-gray-500 mt-1">Sin impuesto estatal · Compact</p>
        </a>
        <a href="/salario-enfermera-florida/" class="block p-5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-emerald-300 hover:bg-emerald-50/40 transition">
          <span class="text-xs font-bold text-emerald-700 uppercase">Florida</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-1">$84,760</p>
          <p class="text-xs text-gray-500 mt-1">Sin impuesto estatal · Compact</p>
        </a>
        <a href="/salario-enfermera-california/" class="block p-5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-emerald-300 hover:bg-emerald-50/40 transition">
          <span class="text-xs font-bold text-emerald-700 uppercase">California</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-1">$137,690</p>
          <p class="text-xs text-gray-500 mt-1">Con impuesto estatal · sin Compact</p>
        </a>
      </div>
      <a href="/salarios-de-enfermeros-en-estados-unidos/" class="text-sm font-bold text-emerald-700 hover:text-emerald-800 underline">
        Ver tabla de salarios por estado (BLS) →
      </a>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Mercado laboral</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-4">
            Demanda de enfermeras registradas en USA
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Según proyecciones del <strong>Bureau of Labor Statistics</strong> (2025–2035), se abren unos <strong>180.800 puestos de RN al año</strong> en Estados Unidos. La demanda de personal bilingüe sigue siendo alta en muchos hospitales.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Empezar homologación y NCLEX con tiempo es lo que puedes controlar; la cola de visa no.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-5 bg-emerald-50 rounded-xl border border-emerald-100">
            <span class="block text-2xl md:text-3xl font-extrabold text-emerald-800">180.800</span>
            <span class="text-xs text-gray-600 font-medium">Aperturas anuales proyectadas de RN (BLS 2025–2035)</span>
          </div>
          <div class="p-5 bg-emerald-50 rounded-xl border border-emerald-100">
            <span class="block text-2xl md:text-3xl font-extrabold text-emerald-800">$97.550</span>
            <span class="text-xs text-gray-600 font-medium">Mediana nacional RN (BLS mayo 2025)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-gray-50 border-b border-gray-100">
    <div class="max-w-screen-lg mx-auto px-4 md:px-8">
      <div class="text-center mb-12">
        <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Preguntas frecuentes</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2">
          Lo que más se pregunta sobre ser enfermera en Estados Unidos
        </h2>
      </div>
      <div class="space-y-5">
        {faqs.map((faq) => (
          <div class="p-6 bg-white rounded-2xl border border-gray-200">
            <h3 class="text-lg font-bold text-gray-900 mb-2">{faq.question}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-500 mt-6 text-center">
        Fuentes:
        <a href="https://www.bls.gov/ooh/healthcare/registered-nurses.htm" target="_blank" rel="noopener" class="underline">BLS OOH</a>
        · <a href="https://www.bls.gov/oes/2023/may/oes291141.htm" target="_blank" rel="noopener" class="underline">BLS OEWS</a>
        · <a href="https://www.ncsbn.org" target="_blank" rel="noopener" class="underline">NCSBN</a>
        · <a href="https://www.cgfns.org" target="_blank" rel="noopener" class="underline">CGFNS</a>
      </p>
    </div>
  </section>

  <!-- Financiación del programa -->
  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mx-auto rounded-2xl border border-emerald-200 bg-emerald-50/60 p-6 md:p-8">
        <span class="text-emerald-700 font-bold text-xs uppercase tracking-wider">Paga a tu ritmo</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-3">
          Fracciona el programa con Klarna o Affirm
        </h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Puedes pagar el programa completo o en cuotas. Hay planes de hasta <strong>36 meses</strong>, desde aproximadamente <strong>$83 al mes</strong>, según la opción y la aprobación de Klarna o Affirm.
        </p>
        <ol class="text-sm text-gray-700 space-y-2 mb-5 list-decimal pl-5">
          <li>En el checkout elige <strong>«Pago completo o en cuotas»</strong>.</li>
          <li>Marca <strong>Klarna</strong> o <strong>Affirm</strong>.</li>
          <li>Completa la solicitud en la plataforma y listo.</li>
        </ol>
        <p class="text-xs text-gray-500 mb-5">
          La cuota exacta, el plazo y la aprobación los define Klarna o Affirm según tu perfil y país. Disponibilidad en el checkout del programa.
        </p>
        <a
          href="https://bit.ly/3R6RbFW"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all"
        >
          Empezar por la sesión informativa gratuita
        </a>
      </div>
    </div>
  </section>

  <section class="bg-emerald-900 text-white py-16">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8 text-center">
      <h2 class="text-2xl md:text-4xl font-extrabold mb-4">
        ¿Lista para la sesión informativa gratuita?
      </h2>
      <p class="text-emerald-100 text-base md:text-lg max-w-2xl mx-auto mb-3">
        En vivo, en español: homologación, costos, NCLEX, empleo con sponsor y visa EB-3. Sin compromiso de compra en la sesión.
      </p>
      <p class="text-emerald-200/90 text-sm max-w-xl mx-auto mb-8">
        Cuando decidas el programa, puedes fraccionarlo con Klarna o Affirm (hasta 36 cuotas, desde ~$83/mes según aprobación).
      </p>
      <a
        href="https://bit.ly/3R6RbFW"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center bg-white text-emerald-900 hover:bg-emerald-50 font-extrabold text-base px-8 py-4 rounded-xl shadow-lg transition-all"
      >
        Agendar mi lugar en la sesión
      </a>
    </div>
  </section>

  <div class="max-w-screen-xl mx-auto px-4 my-8">
    <div class="bg-slate-100 p-4 rounded-lg border border-slate-300 text-xs text-slate-700">
      <span class="font-bold text-emerald-800 bg-emerald-100 px-2 py-1 rounded mr-2">Fuentes</span>
      Contenido orientativo con datos de
      <a href="https://www.bls.gov/ooh/healthcare/registered-nurses.htm" target="_blank" rel="noopener" class="underline">BLS</a>,
      <a href="https://www.ncsbn.org" target="_blank" rel="noopener" class="underline">NCSBN</a> y
      <a href="https://www.cgfns.org" target="_blank" rel="noopener" class="underline">CGFNS</a>.
      Testimonios enlazados a las entrevistas originales en YouTube.
    </div>
  </div>
</BaseLayout>
