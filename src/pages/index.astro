---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { trustpilot, ratingEs } from "@/data/trustpilot.mjs";
import { entrevistas } from "@/data/entrevistas.mjs";

const recientes = entrevistas.slice(0, 3);

// Estrellas de la barra de confianza: relleno proporcional a la puntuación (solo puntuación, sin número de reseñas).
const starsPct = Math.round((trustpilot.ratingValue / 5) * 100);
const starPath = "M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z";

const quickLinks = [
  { href: "/ofertas-de-empleo-para-enfermeras-en-usa/", label: "empleo con sponsor" },
  { href: "/licencia-de-enfermeria-y-examen-nclex-usa/", label: "NCLEX y licencia" },
  { href: "/proceso-de-visa-y-relocalizacion-para-enfermeras/", label: "visa EB-3" },
  { href: "/salarios-de-enfermeros-en-estados-unidos/", label: "salarios por estado" },
  { href: "/enfermera-sin-licencia-rn-en-estados-unidos/", label: "ya estoy en EE.UU. sin licencia RN" },
];

const faqs = [
  {
    question: "¿Dónde veo cuánto pagan a una enfermera en cada estado?",
    answer: "El pago de una RN cambia por estado y por especialidad. La fuente oficial es el Bureau of Labor Statistics (BLS), y reunimos sus cifras por estado en nuestra página de salarios, con el detalle de impuestos y licencia de Texas, Florida, California y Nueva York."
  },
  {
    question: "¿Cómo ser enfermera en Estados Unidos y qué necesito?",
    answer: "En la práctica el camino es: 1) título y licencia de enfermería en tu país, 2) evaluación de credenciales que acepte la junta del estado (p. ej. vía CGFNS/TruMerit u otra autorizada), 3) aprobar el NCLEX-RN, 4) licencia de la junta estatal, 5) demostrar inglés cuando lo exija la junta o el empleador (IELTS, OET, PTE, etc.) y 6) una vía migratoria con sponsor —con frecuencia EB-3 Schedule A— más la oferta de un hospital."
  },
  {
    question: "¿Cuántos años se estudia para enfermera en Estados Unidos?",
    answer: "Si ya eres licenciada o titulado en tu país, no empiezas la carrera de cero: homologas, apruebas el NCLEX y obtienes la licencia estatal. Quien estudia enfermería dentro de EE.UU. suele hacer un ADN (~2 años) o un BSN (~4 años) y luego el NCLEX. Los tiempos de homologación + NCLEX + visa para internacionales se miden en meses o años según documentos, inglés y cola migratoria —no en un plazo único."
  },
  {
    question: "¿Cuáles son los tipos de enfermería en Estados Unidos?",
    answer: "Los niveles más citados son CNA (asistente), LPN/LVN (licencia práctica), RN (Registered Nurse, el objetivo habitual de homologación internacional) y roles avanzados (NP y otros con posgrado). Esta página y nuestro acompañamiento se centran en el camino a RN para hispanohablantes formados en el extranjero."
  },
  {
    question: "¿Puedo pagar el programa a plazos?",
    answer: "Sí. En el checkout puedes pagar el programa completo o fraccionarlo con Klarna o Affirm (según tu país y aprobación de la plataforma). Hay planes de hasta 36 cuotas, desde aproximadamente $88 al mes. En el pago elige «Pago completo o en cuotas», marca Klarna o Affirm y completa la solicitud."
  },
];

const testimonials = [
  {
    name: "Elizabeth Duque",
    headline: "De inglés básico a aprobar el NCLEX-RN",
    detail: "Enfermera colombiana · Aprobó el NCLEX-RN",
    quote: "Pasé el NCLEX a la pregunta 85. Empecé con inglés básico y, con disciplina diaria y acompañamiento, di cada escalón del proceso. La noticia del pass es un logro que no se olvida.",
    videoId: "A13rKHMjH_c",
    videoUrl: "https://www.youtube.com/watch?v=A13rKHMjH_c",
    videoLabel: "Ver entrevista completa en YouTube",
  },
  {
    name: "Sara",
    headline: "Del primer paso a una oferta de hospital",
    detail: "Enfermera colombiana · NCLEX, PTE y oferta hospitalaria",
    quote: "Aprobé el NCLEX, el PTE de inglés y conseguí oferta con hospital. El proceso es largo, pero alcanzable: se vuelve un proyecto de vida. Lo difícil es empezar; después se sigue paso a paso.",
    videoId: "8kfnvoUVvvI",
    videoUrl: "https://www.youtube.com/watch?v=8kfnvoUVvvI",
    videoLabel: "Ver entrevista completa en YouTube",
  },
];
---

<BaseLayout
  title="Enfermera en Estados Unidos: homologación, NCLEX y empleo"
  description="Cómo ser enfermera en EE.UU.: homologación del título, NCLEX-RN, licencia, visa EB-3 y empleo con sponsor. Sesión informativa gratuita en español."
  canonical="https://enfermerausa.com/"
  type="home"
  faqs={faqs}
  rating={true}
>
  <!-- PROPUESTA DE REDISEÑO (borrador): hero con foto + barra de confianza + píldoras. No fusionar sin aprobación del dueño. -->
  <section class="bg-gradient-to-b from-emerald-50 via-white to-white pt-8 pb-10 md:pt-14 md:pb-14">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-7 text-center lg:text-left">
          <span class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 text-[11px] sm:text-xs font-bold px-3 py-1.5 rounded-full mb-5 uppercase tracking-wider">
            Enfermera en Estados Unidos · Acompañamiento en español
          </span>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight leading-[1.1] mb-5">
            <span class="text-emerald-700">Enfermera en Estados Unidos</span>: de la homologación al empleo como RN
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-gray-600 leading-relaxed mb-8 max-w-2xl mx-auto lg:mx-0">
            Acompañamos a enfermeras y enfermeros hispanohablantes en el camino completo: homologación del título, NCLEX-RN, licencia, visa EB-3 y empleo con sponsor. Empieza con la <strong>sesión informativa gratuita</strong>, en español y sin tecnicismos innecesarios.
          </p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4">
            <a
              href="/sesion-informativa/?desde=portada"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-emerald-600/25 transition-all"
            >
              Agendar sesión informativa gratuita
            </a>
            <a
              href="/evaluacion-y-homologacion-de-titulo-enfermeria-usa/"
              class="inline-flex items-center justify-center bg-white hover:bg-emerald-50 text-emerald-800 border-2 border-emerald-200 hover:border-emerald-300 font-semibold text-base px-6 py-4 rounded-xl transition-all"
            >
              Ver el proceso de homologación
            </a>
          </div>
        </div>

        <!-- Foto real ya publicada en el sitio (fundadora, public/logo.webp). Sin imágenes generadas con IA. -->
        <div class="lg:col-span-5">
          <figure class="relative mx-auto w-full max-w-xs sm:max-w-sm lg:max-w-md">
            <div class="absolute -inset-3 rounded-[2rem] bg-emerald-100/70 -rotate-2" aria-hidden="true"></div>
            <img
              src="/logo.webp"
              alt="Alejandra Martínez, RN, BSN, IBCLC, fundadora de Enfermera en Estados Unidos"
              width="600"
              height="600"
              fetchpriority="high"
              decoding="async"
              class="relative w-full aspect-square object-cover rounded-3xl shadow-xl ring-1 ring-black/5"
            />
            <figcaption class="relative -mt-8 mx-4 bg-white/95 backdrop-blur rounded-xl shadow-md px-4 py-3 text-left">
              <p class="text-sm font-bold text-gray-900 leading-tight">Alejandra Martínez, RN, BSN, IBCLC</p>
              <p class="text-xs text-gray-500">Fundadora de Enfermera en Estados Unidos</p>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Barra de confianza integrada (solo puntuación de Trustpilot, SIN número de reseñas) -->
  <section class="bg-white pb-6 md:pb-8 -mt-2" aria-label="Confianza">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 md:divide-x divide-y md:divide-y-0 divide-gray-200 rounded-2xl border border-gray-200 bg-white shadow-sm" data-trustpilot-rating>
        <div class="flex flex-col items-center justify-center gap-1 px-5 py-4 text-center">
          <div class="flex items-center gap-2">
            <span class="relative inline-block h-5 w-[6.25rem]" role="img" aria-label={`${ratingEs} de 5 estrellas en Trustpilot`}>
              <span class="absolute inset-0 flex text-gray-200">
                {[0, 1, 2, 3, 4].map(() => (<svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true"><path d={starPath} /></svg>))}
              </span>
              <span class="absolute inset-y-0 left-0 overflow-hidden" style={`width:${starsPct}%`}>
                <span class="flex w-[6.25rem] text-[#00b67a]">
                  {[0, 1, 2, 3, 4].map(() => (<svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true"><path d={starPath} /></svg>))}
                </span>
              </span>
            </span>
          </div>
          <p class="text-sm text-gray-700"><strong>Calificación en Trustpilot: {ratingEs}/5</strong></p>
          <a href={trustpilot.profileUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-emerald-700 underline">Ver las reseñas en Trustpilot</a>
        </div>

        <div class="flex flex-col items-center justify-center gap-1 px-5 py-4 text-center">
          <p class="text-sm text-gray-700"><strong>Más de 50.000 suscriptores</strong> en YouTube</p>
          <p class="text-xs text-gray-500">Testimonios en video, verificables en el canal oficial</p>
        </div>

        <!-- Aval de Alliance: se suma una tercera celda aquí cuando la Alliance confirme el endoso y ENFERMERAEEU LLC aparezca en su lista oficial de endosantes (decisión del dueño, 25-nov-2026). -->
      </div>
    </div>
  </section>

  <!-- Accesos rápidos: píldoras que se ajustan bien en móvil -->
  <section class="bg-white pb-12 md:pb-14 border-b border-gray-100" aria-label="Accesos rápidos">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <p class="text-center text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">También:</p>
      <ul class="flex flex-wrap justify-center gap-2 sm:gap-3">
        {quickLinks.map((l) => (
          <li>
            <a href={l.href} class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-100 hover:border-emerald-300 transition">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Quién te acompaña</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-4">
            Personas reales, proceso real, en español
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            <strong>Enfermera en Estados Unidos</strong> es el proyecto de acompañamiento que ya conoces en YouTube, Instagram y TikTok: explicación clara del camino a RN —homologación, NCLEX, inglés, empleo con sponsor y visa— sin promesas vacías.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            El canal <strong>Enfermera en Estados Unidos</strong> (más de 50.000 suscriptores) documenta entrevistas con enfermeras que ya dieron esos pasos. Si buscas cómo es el camino de las enfermeras en USA (enfermeras hispanas que homologan su título, aprueban el NCLEX y consiguen empleo), aquí concentramos las guías con fuentes oficiales y la puerta de entrada: la sesión informativa.
          </p>
          <ul class="text-sm text-gray-700 space-y-2">
            <li class="flex gap-2"><span class="text-emerald-600 font-bold">✓</span> Acompañamiento 100% en español</li>
            <li class="flex gap-2"><span class="text-emerald-600 font-bold">✓</span> Testimonios en video, verificables en YouTube</li>
            <li class="flex gap-2"><span class="text-emerald-600 font-bold">✓</span> Contenido alineado a NCSBN, BLS, CGFNS/TruMerit y juntas estatales</li>
          </ul>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 md:p-8">
          <p class="text-sm font-bold text-emerald-800 uppercase tracking-wide mb-3">Cómo ser enfermera en Estados Unidos: el camino en 4 etapas</p>
          <ol class="space-y-3 text-sm text-gray-700">
            <li><strong>1. Homologación</strong> — credenciales y junta estatal. <a href="/evaluacion-y-homologacion-de-titulo-enfermeria-usa/" class="text-emerald-700 underline">Guía</a></li>
            <li><strong>2. NCLEX y licencia</strong> — examen y RN. <a href="/licencia-de-enfermeria-y-examen-nclex-usa/" class="text-emerald-700 underline">Guía</a></li>
            <li><strong>3. Empleo con sponsor</strong> — oferta hospitalaria. <a href="/ofertas-de-empleo-para-enfermeras-en-usa/" class="text-emerald-700 underline">Ofertas</a></li>
            <li><strong>4. Visa y llegada</strong> — EB-3 / green card. <a href="/proceso-de-visa-y-relocalizacion-para-enfermeras/" class="text-emerald-700 underline">Visa</a></li>
          </ol>
          <p class="text-xs text-gray-500 mt-4">¿Ya vives en EE.UU. sin licencia RN? Mira la <a href="/enfermera-sin-licencia-rn-en-estados-unidos/" class="text-emerald-700 underline">guía para obtenerla</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-gray-50 border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-2xl mb-10">
        <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Casos reales</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-3">
          Ellas ya dieron el paso — en sus propias palabras
        </h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          No inventamos reseñas. Estas entrevistas están publicadas en el canal oficial de YouTube; puedes ver el video completo.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t) => (
          <figure class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col">
            <div class="relative w-full overflow-hidden rounded-xl bg-black mb-4" style="padding-bottom:56.25%">
              <!-- Fachada ligera: la home no carga el reproductor de YouTube al abrir; muestra la miniatura del video y el reproductor entra solo al hacer clic. -->
              <button
                type="button"
                class="yt-facade absolute inset-0 w-full h-full cursor-pointer"
                data-yt={t.videoId}
                aria-label={`Reproducir entrevista: ${t.name}`}
              >
                <img
                  class="absolute inset-0 w-full h-full object-cover"
                  src={`https://i.ytimg.com/vi_webp/${t.videoId}/sddefault.webp`}
                  alt={`Entrevista en video: ${t.name}`}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/95 shadow-lg">
                    <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 fill-red-600" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                </span>
              </button>
            </div>
            <h3 class="text-lg md:text-xl font-extrabold text-gray-900 mb-3">{t.headline}</h3>
            <blockquote class="text-gray-700 leading-relaxed text-sm md:text-base flex-1">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-5 pt-4 border-t border-gray-100">
              <p class="font-bold text-gray-900">{t.name}</p>
              <p class="text-xs text-gray-500 mb-3">{t.detail}</p>
              <a
                href={t.videoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-bold text-emerald-700 hover:text-emerald-800 underline"
              >
                {t.videoLabel} →
              </a>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="mt-12">
        <h3 class="text-lg md:text-xl font-extrabold text-gray-900 mb-4">Algunas de nuestras entrevistas recientes</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {recientes.map((e) => (
            <a href={`/entrevistas/#v-${e.id}`} class="block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:border-emerald-300 transition">
              <img src={`https://i.ytimg.com/vi/${e.id}/hqdefault.jpg`} alt={`Entrevista: ${e.titulo}`} loading="lazy" width="480" height="360" class="w-full aspect-video object-cover" />
              <span class="block p-4 text-sm font-bold text-gray-900 leading-snug">{e.titulo}</span>
            </a>
          ))}
        </div>
        <a href="/entrevistas/" class="inline-flex items-center mt-5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all">
          Ver más entrevistas (hay cientos en el canal) →
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-2xl mb-8">
        <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Salarios RN · Datos BLS</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-3">
          Salarios de enfermería: mira tu estado
        </h2>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
          El pago de una RN cambia mucho por estado y por especialidad. Reunimos las cifras oficiales del BLS en una sola página, con impuestos y licencia de cada estado.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <a href="/salario-enfermera-texas/" class="block p-5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-emerald-300 hover:bg-emerald-50/40 transition">
          <span class="text-xs font-bold text-emerald-700 uppercase">Texas</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-1">$95,380</p>
          <p class="text-xs text-gray-500 mt-1">Sin impuesto estatal · Compact</p>
        </a>
        <a href="/salario-enfermera-florida/" class="block p-5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-emerald-300 hover:bg-emerald-50/40 transition">
          <span class="text-xs font-bold text-emerald-700 uppercase">Florida</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-1">$90,650</p>
          <p class="text-xs text-gray-500 mt-1">Sin impuesto estatal · Compact</p>
        </a>
        <a href="/salario-enfermera-california/" class="block p-5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-emerald-300 hover:bg-emerald-50/40 transition">
          <span class="text-xs font-bold text-emerald-700 uppercase">California</span>
          <p class="text-2xl font-extrabold text-gray-900 mt-1">$150,280</p>
          <p class="text-xs text-gray-500 mt-1">Con impuesto estatal · sin Compact</p>
        </a>
      </div>
      <a href="/salarios-de-enfermeros-en-estados-unidos/" class="inline-flex items-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-5 py-3 rounded-lg transition-all">
        Ver la tabla de salarios por estado (BLS) →
      </a>
    </div>
  </section>

  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Mercado laboral</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2 mb-4">
            Demanda de enfermeras registradas en USA
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Según proyecciones del <strong>Bureau of Labor Statistics</strong> (2025–2035), se abren unos <strong>180.800 puestos de RN al año</strong> en Estados Unidos. La demanda de personal bilingüe sigue siendo alta en muchos hospitales.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Empezar homologación y NCLEX con tiempo es lo que puedes controlar; la cola de visa no.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-5 bg-emerald-50 rounded-xl border border-emerald-100">
            <span class="block text-2xl md:text-3xl font-extrabold text-emerald-800">180.800</span>
            <span class="text-xs text-gray-600 font-medium">Aperturas anuales proyectadas de RN (BLS 2025–2035)</span>
          </div>
          <a href="/ofertas-de-empleo-para-enfermeras-en-usa/" class="block p-5 bg-emerald-50 rounded-xl border border-emerald-100 hover:border-emerald-300 transition">
            <span class="block text-lg md:text-xl font-extrabold text-emerald-800">Ofertas con sponsor</span>
            <span class="text-xs text-gray-600 font-medium">Conoce los hospitales con programa para enfermeras internacionales →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-gray-50 border-b border-gray-100">
    <div class="max-w-screen-lg mx-auto px-4 md:px-8">
      <div class="text-center mb-12">
        <span class="text-emerald-600 font-bold text-sm tracking-wider uppercase">Preguntas frecuentes</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mt-2">
          Lo que más se pregunta sobre ser enfermera en Estados Unidos
        </h2>
      </div>
      <div class="space-y-5">
        {faqs.map((faq) => (
          <div class="p-6 bg-white rounded-2xl border border-gray-200">
            <h3 class="text-lg font-bold text-gray-900 mb-2">{faq.question}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-500 mt-6 text-center">
        Fuentes:
