const otros = [
  { slug: "enfermeras-de-colombia-en-estados-unidos", label: "Enfermeras de Colombia en Estados Unidos" },
  { slug: "enfermeras-de-mexico-en-estados-unidos", label: "Enfermeras de México en Estados Unidos" },
  { slug: "enfermeras-de-espana-en-estados-unidos", label: "Enfermeras de España en Estados Unidos" },
