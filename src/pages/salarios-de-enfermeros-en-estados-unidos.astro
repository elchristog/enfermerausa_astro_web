---
import BaseLayout from "@/layouts/BaseLayout.astro";

const salaryStates = [
  { state: "California", avgSalary: "$137,690 / año", hourly: "$66.20 / hr", href: "/salario-enfermera-california/" },
  { state: "Texas", avgSalary: "$90,210 / año", hourly: "$43.37 / hr", href: "/salario-enfermera-texas/" },
  { state: "Florida", avgSalary: "$84,760 / año", hourly: "$40.75 / hr", href: "/salario-enfermera-florida/" },
  { state: "New York", avgSalary: "$106,620 / año", hourly: "$51.26 / hr", href: "/salario-enfermera-nueva-york/" },
  { state: "Illinois", avgSalary: "$90,810 / año", hourly: "$43.66 / hr", href: null },
  { state: "Washington", avgSalary: "$111,030 / año", hourly: "$53.38 / hr", href: null },
];

const faqs = [
  {
    question: "¿Cuánto gana una enfermera en Estados Unidos?",
    answer: "La mediana nacional de una Registered Nurse es $97,550 al año ($46.90/hora) según el BLS (mayo 2025). Por estado, las medias OEWS mayo 2023 incluyen California $137,690, Nueva York $106,620, Texas $90,210 y Florida $84,760."
  },
  {
    question: "¿En qué estado gana más una enfermera RN?",
    answer: "En la tabla BLS OEWS mayo 2023, California tiene una de las medias más altas ($137,690). El neto depende del impuesto estatal y del costo de vida: Texas y Florida no cobran impuesto estatal a la renta."
  },
  {
    question: "¿Cuánto gana una enfermera en Texas y Florida?",
    answer: "Media BLS OEWS mayo 2023: Texas $90,210 al año ($43.37/h) y Florida $84,760 ($40.75/h). Ambos sin impuesto estatal a la renta y en el Nurse Licensure Compact."
  },
];
---

<BaseLayout
  title="Cuánto gana una enfermera en Estados Unidos 2026 | BLS $97,550"
  description="¿Cuánto gana una enfermera en USA? Mediana BLS $97,550. Texas $90,210, Florida $84,760, California $137,690. Tabla por estado, impuestos y Compact."
  canonical="https://enfermerausa.com/salarios-de-enfermeros-en-estados-unidos/"
  type="service"
  faqs={faqs}
>
  <div class="py-12 md:py-20 bg-gray-50 border-b border-gray-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl">
        <span class="text-emerald-700 font-bold text-xs uppercase tracking-wider bg-emerald-100 px-3 py-1 rounded-full">Datos BLS · RN</span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight mt-4 mb-6">
          Cuánto gana una enfermera en Estados Unidos
        </h1>
        <p class="text-lg text-gray-600 leading-relaxed mb-6">
          <strong>Respuesta corta:</strong> la mediana nacional de una Registered Nurse (RN) es <strong>$97,550 al año</strong> ($46.90/hora, BLS mayo 2025). Por estado cambia mucho: California ~$137,690, Texas ~$90,210, Florida ~$84,760 (medias BLS OEWS mayo 2023).
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8 max-w-2xl text-left">
          <a href="/salario-enfermera-texas/" class="rounded-xl border border-emerald-200 bg-white p-4 hover:border-emerald-500 shadow-sm">
            <p class="text-xs font-bold uppercase text-emerald-700">Texas</p>
            <p class="text-xl font-extrabold text-gray-900">$90,210</p>
            <p class="text-xs text-gray-500 mt-1">Sin impuesto estatal · Compact</p>
          </a>
          <a href="/salario-enfermera-florida/" class="rounded-xl border border-emerald-200 bg-white p-4 hover:border-emerald-500 shadow-sm">
            <p class="text-xs font-bold uppercase text-emerald-700">Florida</p>
            <p class="text-xl font-extrabold text-gray-900">$84,760</p>
            <p class="text-xs text-gray-500 mt-1">Sin impuesto estatal · Compact</p>
          </a>
          <a href="/salario-enfermera-california/" class="rounded-xl border border-emerald-200 bg-white p-4 hover:border-emerald-500 shadow-sm">
            <p class="text-xs font-bold uppercase text-emerald-700">California</p>
            <p class="text-xl font-extrabold text-gray-900">$137,690</p>
            <p class="text-xs text-gray-500 mt-1">Más alto · con impuesto estatal</p>
          </a>
        </div>
        <a
          href="/sesion-informativa/"
          class="inline-flex items-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-lg shadow transition-all gap-2"
        >
          <span>Sesión informativa gratuita</span>
        </a>
      </div>
    </div>
  </div>

  <div class="py-16 bg-white">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8 max-w-4xl space-y-8">
      <p class="text-sm text-gray-600 mb-4">Mediana nacional de Registered Nurses (mayo 2025): <strong>$97,550 al año</strong> / $46.90 por hora. Abajo, medias estatales del BLS OEWS (mayo 2023), la tabla estatal completa más reciente publicada en bls.gov que verificamos.</p>
      <h2 class="text-2xl font-bold text-gray-900">Salario medio anual por estado (BLS OEWS, mayo 2023)</h2>

      <div class="overflow-x-auto border border-gray-200 rounded-xl shadow-sm">
        <table class="w-full text-left text-sm text-gray-700">
          <thead class="bg-gray-100 font-bold text-gray-900 uppercase text-xs">
            <tr>
              <th class="px-6 py-4">Estado</th>
              <th class="px-6 py-4">Salario medio anual</th>
              <th class="px-6 py-4">Tarifa por hora</th>
              <th class="px-6 py-4">Guía</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {salaryStates.map((row) => (
              <tr class="hover:bg-emerald-50/50">
                <td class="px-6 py-4 font-bold text-gray-900">{row.state}</td>
                <td class="px-6 py-4 text-emerald-800 font-semibold">{row.avgSalary}</td>
                <td class="px-6 py-4 text-gray-600">{row.hourly}</td>
                <td class="px-6 py-4">
                  {row.href ? (
                    <a href={row.href} class="text-emerald-700 font-semibold underline text-xs">Ver detalle</a>
                  ) : (
                    <span class="text-gray-400 text-xs">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 mt-3">Fuente estatal: <a href="https://www.bls.gov/oes/2023/may/oes291141.htm" target="_blank" rel="noopener" class="underline">BLS OEWS mayo 2023 — Registered Nurses (29-1141)</a>. Mediana nacional: <a href="https://www.bls.gov/ooh/healthcare/registered-nurses.htm" target="_blank" rel="noopener" class="underline">BLS OOH, mayo 2025</a>. Illinois usa el área Chicago–Naperville–Elgin del mismo informe.</p>
    </div>
  </div>


  <!-- Sección GEO / Respuestas Factuales para Google AI Overviews & Destacados SERP -->
  <div class="py-12 bg-slate-50 border-t border-slate-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Preguntas frecuentes sobre salarios de enfermeras en EE.UU.</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faqs.map((f) => (
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="font-bold text-slate-900 text-lg mb-2">{f.question}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{f.answer}</p>
          </div>
        ))}
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-900 text-lg mb-2">¿Hay horas extra y diferenciales?</h3>
          <p class="text-slate-600 text-sm leading-relaxed">La ley federal (FLSA) exige tarifa y media tras 40 h semanales en la mayoría de casos. Muchos hospitales añaden diferenciales nocturnos o de fin de semana; los montos varían por empleador y estado. Bonos de firma o relocalización existen en algunas ofertas, pero no son un estándar fijo: confírmalos en el contrato.</p>
        </div>
      </div>
      <div class="mt-8 text-center">
        <a href="/sesion-informativa/" class="inline-flex items-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-lg shadow text-sm gap-2">
          <span>Reservar sesión informativa</span>
        </a>
      </div>
    </div>
  </div>


  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Enfermera USA",
    "url": "https://enfermerausa.com",
    "description": "Agencia especializada en homologación de títulos de enfermería, examen NCLEX-RN y patrocinio de visa EB-3 para EE.UU.",
    "areaServed": "United States",
    "serviceType": "Nursing License & Visa Sponsorship Agency"
  }
  </script>


  <!-- Bloque Enlazado Interno SEO -->
  <section class="py-8 bg-emerald-900 text-white text-center">
    <div class="max-w-screen-xl mx-auto px-4">
      <h3 class="text-xl font-bold mb-2">¿Listo para dar el paso hacia tu Licencia RN en EE.UU.?</h3>
      <p class="text-emerald-100 text-sm mb-4">Acompáñanos en nuestra próxima Sesión Informativa donde resolveremos tus dudas sobre costos y procesos.</p>
      <a href="/sesion-informativa/" class="inline-block bg-white text-emerald-900 font-bold px-6 py-2.5 rounded-lg shadow hover:bg-emerald-50 transition">
        Reservar sesión informativa
      </a>
      <p class="text-emerald-100 text-xs mt-3"><a href="/evaluacion-y-homologacion-de-titulo-enfermeria-usa/" class="underline">Homologación de título</a> · <a href="/licencia-de-enfermeria-y-examen-nclex-usa/" class="underline">NCLEX y licencia</a></p>
    </div>
  </section>


  <!-- Bloque Resolución Intención: Recargos y Sobretiempos Salariales -->
  <section class="py-12 bg-white border-t border-slate-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900">¿Cómo se Estructura el Pago Mensual de un Enfermero RN en EE.UU.?</h2>
        <p class="text-sm text-slate-600 mt-2">Más allá del salario base por hora, los enfermeros en EE.UU. incrementan sus ingresos con diferenciales de ley.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
        <div class="p-5 bg-emerald-50 rounded-xl border border-emerald-200">
          <h3 class="font-bold text-emerald-900 text-base mb-1">Diferencial Nocturno</h3>
          <p class="text-emerald-700 font-bold mb-2">+$4.00 a +$8.00 USD / hora</p>
          <p class="text-xs text-slate-700">Adicional pagado por trabajar en turnos de 7:00 PM a 7:00 AM.</p>
        </div>
        <div class="p-5 bg-emerald-50 rounded-xl border border-emerald-200">
          <h3 class="font-bold text-emerald-900 text-base mb-1">Overtime (Horas Extra)</h3>
          <p class="text-emerald-700 font-bold mb-2">1.5× tarifa base (varía por estado)</p>
          <p class="text-xs text-slate-700">Bajo la ley federal (FLSA), toda hora trabajada después de la hora 40 semanal se paga a tarifa y media.</p>
        </div>
        <div class="p-5 bg-emerald-50 rounded-xl border border-emerald-200">
          <h3 class="font-bold text-emerald-900 text-base mb-1">Diferencial Fin de Semana</h3>
          <p class="text-emerald-700 font-bold mb-2">+$3.00 a +$6.00 USD / hora</p>
          <p class="text-xs text-slate-700">Bonificación por turnos asignados de sábado a domingo.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- Bloque E-E-A-T Autoría y Revisión -->
  <div class="max-w-screen-xl mx-auto px-4 my-8">
    <div class="bg-slate-100 p-4 rounded-lg border border-slate-300 flex items-center gap-4 text-xs text-slate-700">
      <span class="font-bold text-emerald-800 bg-emerald-100 px-2 py-1 rounded">✓ Información Verificada</span>
      <span>Contenido redactado y revisado por el Equipo Especializado en Licencias Médicas de EE.UU. (CGFNS & NCLEX Specialists). Fuentes oficiales: <a href="https://www.ncsbn.org" target="_blank" rel="noopener" class="underline">NCSBN</a> | <a href="https://www.cgfns.org" target="_blank" rel="noopener" class="underline">CGFNS</a>.</span>
    </div>
  </div>


  <!-- Bloque Outrank Competidor: Salario Neto por Estado -->
  <section class="py-12 bg-slate-900 text-white border-t border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Ingresos Reales vs Impuestos</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white">¿Cuánto Dinero Líquido Recibes al Mes en tu Cuenta?</h2>
        <p class="text-sm text-slate-300 mt-2">Bruto aproximado a ~36 h/semana con la media estatal BLS (mayo 2023). El neto exacto depende de tu situación federal; la columna clave es si el estado cobra renta o no.</p>
      </div>

      <div class="overflow-x-auto bg-slate-800 rounded-2xl border border-slate-700 text-xs">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-950 text-emerald-400 font-bold">
              <th class="p-4">Estado</th>
              <th class="p-4">Salario Bruto Mensual</th>
              <th class="p-4">Impuesto Estatal a la Renta</th>
              <th class="p-4 font-bold text-white">Ingreso Neto Estimado en Banco</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700 text-slate-200">
            <tr>
              <td class="p-4 font-bold text-white">Texas (Houston / Dallas)</td>
              <td class="p-4">~$6,770 USD</td>
              <td class="p-4 text-emerald-400 font-bold">0% (sin impuesto estatal)</td>
              <td class="p-4 font-bold text-emerald-300">Mayor neto relativo (solo federal + FICA)</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-white">Florida (Orlando / Miami)</td>
              <td class="p-4">~$6,360 USD</td>
              <td class="p-4 text-emerald-400 font-bold">0% (sin impuesto estatal)</td>
              <td class="p-4 font-bold text-emerald-300">Mayor neto relativo (solo federal + FICA)</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-white">Illinois (Chicago)</td>
              <td class="p-4">~$6,810 USD</td>
              <td class="p-4 text-slate-300">Impuesto estatal (flat ~4.95%)</td>
              <td class="p-4 font-bold text-emerald-300">Neto menor que TX/FL a igual bruto</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-white">California (Los Ángeles / Bay Area)</td>
              <td class="p-4">~$10,330 USD</td>
              <td class="p-4 text-slate-300">Impuesto estatal progresivo</td>
              <td class="p-4 font-bold text-emerald-300">Bruto alto; neto y arriendo varían mucho</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>


  <!-- Bloque Answer-First GEO -->
  <div class="max-w-screen-xl mx-auto px-4 my-6">
    <div class="p-5 bg-emerald-50 border-l-4 border-emerald-600 rounded-r-lg">
      <p class="text-xs font-bold text-emerald-800 uppercase tracking-wide">📌 Resumen Clave del Proceso:</p>
      <p class="text-sm font-semibold text-slate-900 mt-1">Para ejercer como enfermero registrado (RN) en EE.UU. en 2026 se requiere: 1) Homologar créditos con CGFNS o TruMerit, 2) Aprobar el examen adaptativo NCLEX-RN (85-150 preguntas NGN), 3) Demostrar inglés (OET u IELTS), y 4) Obtener patrocinio de Visa EB-3 de Residencia Permanente directa (Schedule A).</p>
    </div>
  </div>

  






  <!-- Ultima Auditoria y Actualizacion SEO/GEO de Registro Factual 2026: Ciclo #105 -->
</BaseLayout>
