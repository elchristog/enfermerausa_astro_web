---
const destination = "https://enfermerausa.com/blog/home/";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Blog | Enfermera en Estados Unidos</title>
    <meta name="description" content="Blog para enfermeras hispanas en Estados Unidos: guías paso a paso de homologación del título, NCLEX, licencia RN, visa y empleo hospitalario." />
    <link rel="canonical" href={destination} />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p><a href={destination}>Ir al blog</a></p>
  </body>
</html>
