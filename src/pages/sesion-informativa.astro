---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Sesión Informativa Gratuita para Enfermeras | Enfermera USA";
const description = "Reserva tu lugar en la sesión gratuita y conoce el camino de homologación, NCLEX, empleo y visa para ejercer enfermería en Estados Unidos.";
const canonical = "https://enfermerausa.com/sesion-informativa/";
const calendlyUrl = "https://calendly.com/enfermeraenestadosunidos/homologacion-enfermeria-reunion-informativa";
---

<BaseLayout title={title} description={description} canonical={canonical} type="service">
  <section class="bg-slate-50 py-10 md:py-14">
    <div class="mx-auto max-w-5xl px-4 md:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-[#CC3700]">Sesión gratuita en vivo · 60 minutos</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-[#2C3E50] md:text-5xl">Tu ruta para ejercer enfermería en Estados Unidos</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">En una hora saldrás con el mapa claro: homologación, NCLEX, empleo y visa. Solo para licenciados en enfermería. Elige tu horario abajo.</p>
        <div class="mx-auto mt-6 grid max-w-2xl gap-3 text-left sm:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
            <p class="text-sm font-bold text-[#2C3E50]">1. Requisitos reales</p>
            <p class="mt-1 text-sm text-slate-500">Qué pide CGFNS y en qué orden.</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
            <p class="text-sm font-bold text-[#2C3E50]">2. Costos y tiempos</p>
            <p class="mt-1 text-sm text-slate-500">Cuánto cuesta y cuánto tarda.</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
            <p class="text-sm font-bold text-[#2C3E50]">3. Tus preguntas</p>
            <p class="mt-1 text-sm text-slate-500">Espacio en vivo para resolver dudas.</p>
          </div>
        </div>
        <div class="mx-auto mt-6 max-w-2xl rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-left">
          <p class="text-sm font-bold text-emerald-900">Paga el programa a tu ritmo</p>
          <p class="mt-1 text-sm text-emerald-900/80 leading-relaxed">
            Si después de la sesión eliges el programa, puedes fraccionarlo con <strong>Klarna</strong>, <strong>Affirm</strong> o <strong>Afterpay</strong>: hasta <strong>36 cuotas</strong>, desde aproximadamente <strong>$83 al mes</strong> (sujeto a aprobación y país). En el checkout elige «Pago completo o en cuotas con Klarna» y marca Klarna, Affirm o Afterpay.
          </p>
        </div>
        <p class="mx-auto mt-5 max-w-xl text-sm text-slate-500">Cupos limitados por sesión. Confirmación y recordatorios llegan a tu correo.</p>
      </div>

      <div class="mx-auto mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div id="booking-intro" class="border-b border-slate-100 px-6 py-5 text-center">
          <p class="font-semibold text-[#2C3E50]">Elige tu horario y reserva tu lugar</p>
          <p class="mt-1 text-sm text-slate-500">Gratis · En español · Solo licenciados en enfermería</p>
        </div>
        <!-- Placeholder: no Calendly CSS/JS on critical path. Widget loads when this is near viewport. -->
        <div id="calendly-embed" class="relative" style="min-width: 320px; min-height: 720px;">
          <div id="calendly-skeleton" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-slate-50 px-6 text-center">
            <div class="h-10 w-10 animate-pulse rounded-full bg-emerald-200"></div>
            <p class="text-sm font-semibold text-[#2C3E50]">Cargando horarios disponibles…</p>
            <p class="text-xs text-slate-500">Si tarda, <a id="calendly-fallback-link" class="font-bold text-emerald-700 underline" href="https://calendly.com/enfermeraenestadosunidos/homologacion-enfermeria-reunion-informativa" target="_blank" rel="noopener noreferrer">abre el calendario en una pestaña nueva</a>.</p>
          </div>
        </div>
        <div id="booking-success" class="hidden px-6 py-8 text-center">
          <p class="text-2xl font-extrabold text-[#27AE60]">Tu reserva está confirmada</p>
          <p class="mx-auto mt-3 max-w-xl text-base font-semibold text-[#2C3E50]">Haz estas 3 cosas ahora (toman 1 minuto):</p>
          <ol class="mx-auto mt-3 max-w-xl list-decimal space-y-2 pl-5 text-left text-slate-600">
            <li>Abre el correo de Calendly y <strong>guarda el enlace de Google Meet</strong> en tu teléfono.</li>
            <li>Añade la sesión a tu calendario desde ese mismo correo.</li>
            <li>El día de la sesión, <strong>entra 5 minutos antes</strong> con el enlace de Meet (no uses el grupo de WhatsApp para entrar).</li>
          </ol>
          <p class="mx-auto mt-4 max-w-xl text-sm text-slate-500">Los recordatorios llegan por correo y SMS. El acceso es el enlace de Google Meet del correo de confirmación.</p>
          <div class="mx-auto mt-6 max-w-xl rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-left">
            <p class="text-sm font-bold text-emerald-900">Después de la sesión: resuelve dudas en una llamada 1:1</p>
            <p class="mt-1 text-sm text-emerald-900/80 leading-relaxed">Si te queda claro el camino y quieres aterrizar tu caso (pago completo, cuotas o plan), agenda tu llamada de resolución de dudas.</p>
            <a href="https://calendly.com/enfermeraenestadosunidos/resolucion-de-dudas" target="_blank" rel="noopener noreferrer" class="mt-3 inline-block rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-500">Agendar mi llamada 1:1</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var CALENDLY_URL = 'https://calendly.com/enfermeraenestadosunidos/homologacion-enfermeria-reunion-informativa';
      var loaded = false;

      function loadCalendly() {
        if (loaded) return;
        loaded = true;

        // DNS early, only when we actually need the widget
        var pre1 = document.createElement('link');
        pre1.rel = 'preconnect';
        pre1.href = 'https://assets.calendly.com';
        pre1.crossOrigin = 'anonymous';
        document.head.appendChild(pre1);
        var pre2 = document.createElement('link');
        pre2.rel = 'preconnect';
        pre2.href = 'https://calendly.com';
        document.head.appendChild(pre2);

        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://assets.calendly.com/assets/external/widget.css';
        document.head.appendChild(css);

        var s = document.createElement('script');
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.async = true;
        s.onload = function () {
          if (!window.Calendly) return;
          var parent = document.getElementById('calendly-embed');
          if (!parent) return;
          window.Calendly.initInlineWidget({
            url: CALENDLY_URL,
            parentElement: parent,
            resize: true
          });
          var sk = document.getElementById('calendly-skeleton');
          if (sk) {
            // Hide skeleton once iframe appears (Calendly injects async)
            var tries = 0;
            var t = setInterval(function () {
              tries += 1;
              if (parent.querySelector('iframe') || tries > 40) {
                clearInterval(t);
                sk.remove();
              }
            }, 150);
          }
        };
        document.body.appendChild(s);
      }

      function arm() {
        var el = document.getElementById('calendly-embed');
        if (!el) return loadCalendly();
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            if (entries.some(function (e) { return e.isIntersecting; })) {
              io.disconnect();
              // After paint: idle if available, else short delay
              var idle = window.requestIdleCallback || function (cb) { setTimeout(cb, 200); };
              idle(function () { loadCalendly(); }, { timeout: 1500 });
            }
          }, { rootMargin: '200px 0px' });
          io.observe(el);
        } else {
          window.addEventListener('load', function () {
            setTimeout(loadCalendly, 300);
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', arm);
      } else {
        arm();
      }

      window.addEventListener('message', function (event) {
        if (event.origin !== 'https://calendly.com') return;
        if (!event.data || event.data.event !== 'calendly.event_scheduled') return;

        var eventId = 'calendly_' + Date.now() + '_' + Math.random().toString(36).slice(2);
        if (window.fbq) {
          window.fbq('track', 'Schedule', { content_name: 'Sesión informativa gratuita' }, { eventID: eventId });
        }
        if (window.gtag) {
          window.gtag('event', 'generate_lead', {
            event_category: 'Calendly',
            event_label: 'Sesión informativa gratuita'
          });
          window.gtag('event', 'conversion', {
            send_to: 'AW-988351308/X-rGCIvD_IAdEMyWpNcD'
          });
        }
        var success = document.getElementById('booking-success');
        if (success) success.classList.remove('hidden');
      });
    })();
  </script>
</BaseLayout>
