---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Sesión Informativa Gratuita para Enfermeras | Enfermera USA";
const description = "Reserva tu lugar en la sesión gratuita y conoce el camino de homologación, NCLEX, empleo y visa para ejercer enfermería en Estados Unidos.";
const canonical = "https://enfermerausa.com/sesion-informativa/";
const calendlyUrl = "https://calendly.com/enfermeraenestadosunidos/homologacion-enfermeria-reunion-informativa";
---

<BaseLayout title={title} description={description} canonical={canonical} type="service">
  <section class="bg-slate-50 py-10 md:py-14">
    <div class="mx-auto max-w-5xl px-4 md:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-3 text-sm font-bold uppercase tracking-wide text-[#CC3700]">Sesión gratuita en vivo</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-[#2C3E50] md:text-5xl">Tu ruta para ejercer enfermería en Estados Unidos</h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">En una hora entenderás los pasos de homologación, preparación NCLEX, empleo y visa. Reserva el horario que mejor te funcione y trae tus preguntas.</p>
      </div>

      <div class="mx-auto mt-8 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div id="booking-intro" class="border-b border-slate-100 px-6 py-5 text-center">
          <p class="font-semibold text-[#2C3E50]">Elige tu horario para reservar tu lugar</p>
          <p class="mt-1 text-sm text-slate-500">La confirmación y los recordatorios llegarán a tu correo.</p>
        </div>
        <div id="calendly-embed" style="min-width: 320px; height: 750px;"></div>
        <div id="booking-success" class="hidden px-6 py-8 text-center">
          <p class="text-2xl font-extrabold text-[#27AE60]">Tu reserva está confirmada</p>
          <p class="mx-auto mt-2 max-w-xl text-slate-600">Revisa tu correo para guardar el horario y recibir los recordatorios antes de la sesión.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="https://assets.calendly.com/assets/external/widget.js"></script>
  <script is:inline>
    window.addEventListener('load', function() {
      if (window.Calendly) {
        window.Calendly.initInlineWidget({
          url: 'https://calendly.com/enfermeraenestadosunidos/homologacion-enfermeria-reunion-informativa',
          parentElement: document.getElementById('calendly-embed'),
          resize: true
        });
      }
    });

    window.addEventListener('message', function(event) {
      if (event.origin !== 'https://calendly.com') return;
      if (!event.data || event.data.event !== 'calendly.event_scheduled') return;

      if (window.fbq) window.fbq('track', 'Schedule', { content_name: 'Sesión informativa gratuita' });
      if (window.gtag) window.gtag('event', 'generate_lead', { event_category: 'Calendly', event_label: 'Sesión informativa gratuita' });

      var success = document.getElementById('booking-success');
      if (success) success.classList.remove('hidden');
    });
  </script>
</BaseLayout>
