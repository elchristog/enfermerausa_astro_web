---
import { legacyRedirects } from '../data/legacy-redirects.mjs';

export function getStaticPaths() {
  return Object.entries(legacyRedirects).map(([from, to]) => ({
    params: { legacy: from },
    props: { to },
  }));
}

const { to } = Astro.props;
const destination = new URL(to, 'https://enfermerausa.com').href;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Redirección | Enfermera en Estados Unidos</title>
    <link rel="canonical" href={destination} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>Esta página se movió. <a href={destination}>Continuar</a>.</p>
  </body>
</html>
